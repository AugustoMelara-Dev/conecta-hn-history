{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vitobusinessos.com/schemas/auth/user_password_changed.v1.json",
  "title": "UserPasswordChanged Event v1",
  "description": "Domain event emitted when a user successfully changes their password",
  "type": "object",
  "required": ["event_id", "type", "schema_version", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event instance"
    },
    "type": {
      "type": "string",
      "const": "auth.user_password_changed",
      "description": "Canonical event type identifier"
    },
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Version of the event schema"
    },
    "payload": {
      "type": "object",
      "required": ["user_id", "tenant_id", "occurred_at", "session_invalidated"],
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid",
          "description": "ID of the user whose password was changed"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Tenant context for multi-tenant isolation"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO8601 timestamp when the event occurred"
        },
        "session_invalidated": {
          "type": "boolean",
          "description": "Whether all sessions were revoked as part of this change"
        }
      }
    }
  }
}
