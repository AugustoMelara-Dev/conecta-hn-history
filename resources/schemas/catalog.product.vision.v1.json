{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:conecta:catalog:product:vision:v1",
    "title": "Catalog product vision result v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "description",
        "short_description",
        "category_suggestion",
        "tags",
        "colors",
        "material",
        "dimensions",
        "variations",
        "condition",
        "warnings",
        "price",
        "stock_quantity",
        "unit",
        "field_confidence",
        "overall_confidence",
        "review_reasons"
    ],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
        },
        "description": {
            "type": "string",
            "maxLength": 2000
        },
        "short_description": {
            "type": ["string", "null"],
            "maxLength": 320
        },
        "category_suggestion": {
            "type": ["string", "null"],
            "maxLength": 100
        },
        "tags": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
            }
        },
        "colors": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
            }
        },
        "material": {
            "type": ["string", "null"],
            "maxLength": 100
        },
        "dimensions": {
            "oneOf": [
                {"type": "null"},
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["width", "height", "depth", "unit"],
                    "properties": {
                        "width": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100000},
                        "height": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100000},
                        "depth": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100000},
                        "unit": {"type": ["string", "null"], "enum": ["mm", "cm", "m", "in", null]}
                    }
                }
            ]
        },
        "variations": {
            "type": "array",
            "maxItems": 12,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "options"],
                "properties": {
                    "name": {"type": "string", "minLength": 1, "maxLength": 60},
                    "options": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 20,
                        "uniqueItems": true,
                        "items": {"type": "string", "minLength": 1, "maxLength": 60}
                    }
                }
            }
        },
        "condition": {
            "type": ["string", "null"],
            "enum": ["new", "used", "refurbished", null]
        },
        "warnings": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
            }
        },
        "price": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 9999999.99
        },
        "stock_quantity": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 10000000
        },
        "unit": {
            "type": ["string", "null"],
            "maxLength": 30
        },
        "field_confidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "description",
                "short_description",
                "category_suggestion",
                "tags",
                "colors",
                "material",
                "dimensions",
                "variations",
                "condition",
                "warnings",
                "price",
                "stock_quantity",
                "unit"
            ],
            "properties": {
                "name": {"type": "number", "minimum": 0, "maximum": 1},
                "description": {"type": "number", "minimum": 0, "maximum": 1},
                "short_description": {"type": "number", "minimum": 0, "maximum": 1},
                "category_suggestion": {"type": "number", "minimum": 0, "maximum": 1},
                "tags": {"type": "number", "minimum": 0, "maximum": 1},
                "colors": {"type": "number", "minimum": 0, "maximum": 1},
                "material": {"type": "number", "minimum": 0, "maximum": 1},
                "dimensions": {"type": "number", "minimum": 0, "maximum": 1},
                "variations": {"type": "number", "minimum": 0, "maximum": 1},
                "condition": {"type": "number", "minimum": 0, "maximum": 1},
                "warnings": {"type": "number", "minimum": 0, "maximum": 1},
                "price": {"type": "number", "minimum": 0, "maximum": 1},
                "stock_quantity": {"type": "number", "minimum": 0, "maximum": 1},
                "unit": {"type": "number", "minimum": 0, "maximum": 1}
            }
        },
        "overall_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "review_reasons": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
            }
        }
    }
}
