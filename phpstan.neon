includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
        - tests/

    # Level 5: Checks argument types and return types.
    # Good balance between strictness and developer velocity for existing codebases.
    level: 5

    # Ignore false positives from third-party libraries if necessary.
    # Currently empty for strict checking of Domain and Application layers.
    ignoreErrors: []

    # Set to true to force documentation of array types (e.g. array<int, string>).
    # Essential for our DTO -> TS generation pipeline.

