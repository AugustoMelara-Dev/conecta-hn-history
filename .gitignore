# ----------------------------------------------------------------------
# VITO BUSINESS OS - shared gitignore
# Keep local secrets, build output, diagnostics, and runtime artifacts
# out of version control.
# ----------------------------------------------------------------------

# Secrets and credentials
.env
.env.*
.env.backup
.env.production
.env.staging
.env.local
auth.json
*.key
*.pem
*.p12
.credentials/

# Dependencies
/vendor
/node_modules

# Build output
/public/build
/public/hot
/public/storage
/public/css/filament
/public/js/filament
*.compiled.*
.vite/

# Cache and logs
*.log
*.cache
.composer-cache/
.phpunit.result.cache
.phpunit.cache/
storage/*.key
storage/pail/
storage/logs/*
!storage/logs/.gitkeep
storage/framework/cache/*
!storage/framework/cache/.gitkeep
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/framework/views/*
!storage/framework/views/.gitkeep
bootstrap/cache/*.php
/bootstrap/cache/filament/

# Editors and IDEs
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.sublime-*
*.swp
*.swo
.phpactor.json
.project
.classpath
.settings/
nbproject/

# Operating system noise
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*.bak
*~

# Testing
/coverage
.phpunit.result.cache
phpunit.xml.bak
.pest/
.phpunit/

# Deployment
Homestead.json
Homestead.yaml
docker-compose.override.yml
.vagrant/
*.box

# Local uploads
storage/app/public/*
!storage/app/public/.gitkeep

# Temporary files
*.tmp
*.temp
*.swp
.sass-cache/

# Databases
*.sqlite
*.sqlite-journal
database/database.sqlite

# Local audit output
AUDIT_REPORT.md
QA_CERTIFICATION.md
error_log.txt

# Development scratch files
todo.md
notes.md
scratch.php
test.php

# Generated debug and evidence artifacts
/analysis_out.txt
/evidence*.txt
/*_result*.txt
/*_output*.txt
/*_final*.txt
/*_error*.txt
/*_evidence*.txt
/*_install*.txt
/git_status*.txt
/debug_*.txt
/full_pest.txt
/pest*.txt
/test*.txt
/tests_output.txt
/discovery*.txt
/optimize*.txt
/latest_error*.txt
/http_evidence.txt
/spatie_result.txt

# PHPStan and static analysis snapshots
/phpstan*.json
/arch_*detailed.txt
/fortify_actions_inspect.txt

# Root-level local diagnostics
/*.py
/discovery.ps1
/run_evidence.sh
/test.php
/cols.json
/http_diagnostic.md
/pest_arch_result*.txt
bootstrap/cache/*.tmp

# Codex and local runtime artifacts
/.codex-admin-dashboard.html
/.codex-admin-login.html
/_tmp_admin_probe.php
/route-list.json
/.codex-appdata/runtime/
/.codex-appdata/PsySH/
/playwright-report/
/test-results/
/reports/
/artifacts/
/artifacts/manual-audit/
/artifacts/closure/
/e2e-pr-smoke-auth-junit.xml
/e2e-*.xml

# Local E2E/test runtime artifacts
/.tmp-e2e-db-bootstrap.php
/system-tests*.xml
/storage/testing/

.vercel
