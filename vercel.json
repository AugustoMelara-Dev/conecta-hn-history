{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.7.4"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "https://vito-business-os-production.up.railway.app/$1"
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/index.php",
      "dest": "/index.php"
    },
    {
      "src": "/(.*\\.php)",
      "dest": "/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
