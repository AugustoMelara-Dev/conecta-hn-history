                      "hostile_tools":  [
                                            "commerce.order.create"
                                        ],
                      "forbidden_fragments":  [
                                                  "SECRETO TENANT AJENO",
                                                  "NO DEBE APARECER",
                                                  "MODEL INVENTION",
                                                  "MODEL REASON"
                                              ],
                      "provider_cost_usd":  0.01,
                      "expected_execution_status":  "completed",
                      "expected_items":  [
                                             "owned"
                                         ]
                  },
                  {
                      "id":  "private-catalog-isolation",
