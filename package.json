{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "perf:budget": "node scripts/ci/check-performance-budgets.mjs",
        "perf:auth-cookie": "node scripts/perf/auth-cookie.mjs",
        "perf:p95-smoke": "node scripts/perf/p95-smoke.mjs",
        "check:ui-guardrails": "node scripts/ci/check-ui-guardrails.mjs",
        "test:e2e": "playwright test",
        "test:e2e:smoke": "playwright test tests/e2e/smoke-post-deploy.spec.ts --reporter=list,html,junit",
        "test:e2e:pr-smoke-auth": "playwright test tests/e2e/smoke-auth-core.spec.ts tests/e2e/auth-flow.spec.ts --reporter=list,html,junit",
        "test:e2e:extended-nightly": "playwright test tests/e2e/full-platform-audit.spec.ts tests/e2e/security-auth-audit.spec.ts --reporter=list,html,junit",
        "test:e2e:release": "playwright test tests/e2e/booking-flow.spec.ts tests/e2e/storefront-verticals.spec.ts",
        "test:e2e:release:critical": "playwright test tests/e2e/auth-flow.spec.ts tests/e2e/checkout-flow.spec.ts tests/e2e/booking-flow.spec.ts tests/e2e/storefront-verticals.spec.ts --reporter=list,html,junit",
        "test:e2e:headed": "playwright test --headed",
        "test:ui": "vitest run resources/js/__tests__ --passWithNoTests",
        "type-check": "tsc --noEmit",
        "types:sync": "php artisan typescript:transform"
    },
