{
    "preset": "laravel",
    "rules": {
        "group_import": false,
        "single_import_per_statement": true,
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha",
            "imports_order": [
                "const",
                "class",
                "function"
            ]
        }
    }
}